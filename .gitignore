.DS_Store

# Local git worktrees (implementation isolation)
/.worktrees/

.superpowers/
# Everything under `.claude/` is local, except the project's own skills: they are how a
# fresh session learns this repo's workflows, so they belong in the repository rather than
# in one machine's config. Note the `/*` — nothing inside a directory that is itself
# excluded can be re-included.
.claude/*
!.claude/skills/

# TypeScript port (packages/)
node_modules/
dist/
/test-results/
/playwright-report/

# Electron shell (packages/desktop): bundled main/preload + renderer, and electron-builder output
/packages/desktop/out/
/packages/desktop/release/
/packages/desktop/test-results/
/packages/desktop/playwright-report/
