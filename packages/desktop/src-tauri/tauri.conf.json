{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SimCity",
  "version": "0.1.0",
  "identifier": "dev.simcity.desktop",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "bun run --cwd ../.. dev",
    "beforeBuildCommand": "bunx vite build ../app --emptyOutDir"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
