(
    // How dark the deepest night gets, 0..1 (1.0 = full-black night curve).
    night_darkness: 0.55,
    // Sun illuminance (lux) at full day.
    sun_day_illuminance: 12000.0,
    // Camera ambient brightness at full day.
    ambient_day_brightness: 700.0,
    // Night emissive multipliers: building windows, road markings, traffic-light pools.
    window_glow: 1.0,
    marking_glow: 1.0,
    light_pool_glow: 1.0,
)
