{
  "name": "simcity-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "deprecated/packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/app && tsc -p packages/app/tsconfig.worker.json && tsc -p packages/desktop && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "e2e": "playwright test",
    "dev": "vite packages/app",
    "desktop:dev": "bun tools/desktop-dev.ts",
    "desktop:build": "bun run --cwd packages/desktop build",
    "desktop:build:obfuscated": "bun run --cwd packages/desktop build:obfuscated",
    "desktop:build:test": "bun run --cwd packages/desktop build:test",
    "desktop:e2e": "playwright test -c packages/desktop/playwright.config.ts",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "vite build packages/app",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run test:life-week",
    "test:life-week": "bun tools/test-life-week.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
